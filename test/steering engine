## 测试舵机

#include <ESP32Servo.h>

// 定义两个舵机对象
Servo servoPan;
Servo servoTilt;

// 定义引脚
#define SERVO_PAN_PIN  0
#define SERVO_TILT_PIN 1

void setup() {
  Serial.begin(115200);
  
  // 初始化舵机（ESP32 的 PWM 信号频率默认为 50Hz，脉宽 500-2400us 对应 0-180 度）
  servoPan.attach(SERVO_PAN_PIN, 500, 2400);
  servoTilt.attach(SERVO_TILT_PIN, 500, 2400);
  
  Serial.println("Servo Test Start!");
}

void loop() {
  // 水平舵机从 0 度转到 180 度，再转回来
  Serial.println("Moving Pan Servo to 0");
  servoPan.write(0);
  delay(1000);
  
  Serial.println("Moving Pan Servo to 180");
  servoPan.write(180);
  delay(1000);

  // 俯仰舵机从 0 度转到 180 度，再转回来
  Serial.println("Moving Tilt Servo to 0");
  servoTilt.write(0);
  delay(1000);
  
  Serial.println("Moving Tilt Servo to 180");
  servoTilt.write(180);
  delay(1000);
}
